# Bu dosyayı .env olarak kopyala: cp .env.example .env
# Gerçek .env commit edilmez (.gitignore'da).

# PostgreSQL (pgvector eklentisi kurulu olmalı). Async sürücü: asyncpg.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zemin360

# development | production
APP_ENV=development

# CORS: frontend'in çalıştığı origin'ler, virgülle ayrılmış.
CORS_ORIGINS=http://localhost:3000

# JWT imza anahtarı (zorunlu, en az 32 karakter). Tanımlı değilse uygulama açılmaz.
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Canlıda ayrı bir değer kullan; paylaşma.
JWT_GIZLI_ANAHTAR=

# Demo hesaplarının ortak şifresi (en az 8 karakter). Yalnızca
# scripts/demo_hesaplari.py okur; uygulama kullanmaz.
DEMO_SIFRESI=

# Canlılık taraması için cron anahtarı (boş ya da en az 32 karakter). Canlıdaki
# zamanlanmış görev POST /canlilik/tarama'yı X-Tarama-Anahtari başlığıyla çağırır.
# Boşsa uç yalnızca GİRVAK token'ıyla (paneldeki düğme) çalışır.
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
TARAMA_ANAHTARI=

# LLM: Gemini, ücretli katman (faturalandırması açık bir projenin anahtarı).
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Model katmanları (app/core/llm.py). Boş bırakılırsa koddaki varsayılan
# kullanılır; kod değiştirmeden model değiştirmek için buradan ayarla.
#   Hızlı katman — yapılandırılmış çıkarım: Keşif ve Tanımlama sohbetleri.
# GEMINI_HIZLI_MODEL=gemini-3.6-flash
# GEMINI_HIZLI_YEDEK_MODEL=gemini-3.1-flash-lite
#   Hızlı katmanın düşünme seviyesi: minimal | low | medium | high | boş (modelin
#   varsayılanı). Geçersiz değer açılışta hata verir. Güçlü katmana uygulanmaz.
# GEMINI_HIZLI_DUSUNME=minimal
#   Güçlü katman — gerekçeli akıl yürütme: eşleştirme gerekçesi, doğrulama rubriği.
#   Varsayılan kararlı (preview olmayan) bir model; preview modeller demo günü sürpriz
#   çıkarabilir. Yeni anahtarlara kararlı bir Pro açık değil (gemini-2.5-pro 404 dönüyor).
# GEMINI_GUCLU_MODEL=gemini-3.8-flash
# GEMINI_GUCLU_YEDEK_MODEL=gemini-3.6-flash
# Yedek modele sağlayıcı arızasında (5xx, zaman aşımı), anlık hız sınırında (429)
# ve model kullanılamadığında (404) düşülür. Açılışta bu dört model adı sağlayıcının
# listesiyle karşılaştırılır, bulunamayan log'da uyarılır (uygulama durmaz).
# Tek çağrı bu kadar saniyeyi aşarsa zaman aşımı sayılır.
# GEMINI_ZAMAN_ASIMI_SN=30

# Embedding (Voyage AI) — kart onaylanınca temsil metni buradan vektöre çevrilir.
# https://dashboard.voyageai.com
VOYAGE_API_KEY=

# Kanıt okuma: GitHub API saatte 60 istekle sınırlı; jeton (yalnızca okuma, kapsamsız) 5000 yapar. Boş kalabilir.
GITHUB_TOKEN=

# E-posta (kayıt doğrulaması, ileride referans): resend | log | kapali.
# log: gönderilmez, bağlantı backend log'una yazılır (yerel deneme).
# resend: RESEND_API_KEY ve Resend'de doğrulanmış alan adından EPOSTA_GONDEREN gerekir;
# biri eksikse açılışta log kipine düşülür.
EPOSTA_SAGLAYICI=log
RESEND_API_KEY=
# EPOSTA_GONDEREN=Zemin360 <bildirim@alan-adiniz.org>
# E-postadaki bağlantıların açtığı frontend adresi.
UYGULAMA_ADRESI=http://localhost:3000

# Hesap bağlama (OAuth). Boş bırakılan sağlayıcı kapalıdır, arayüzde görünmez.
# Uygulamayı açarken dönüş adresi: {UYGULAMA_ADRESI}/hesap-baglama/{github|gitlab|orcid}
# GitHub: Settings > Developer settings > OAuth Apps (kapsam: read:user)
GITHUB_OAUTH_ISTEMCI=
GITHUB_OAUTH_GIZLI=
# GitLab: User settings > Applications (kapsam: read_user)
GITLAB_OAUTH_ISTEMCI=
GITLAB_OAUTH_GIZLI=
# ORCID: Developer Tools > Public API (kapsam: /authenticate)
ORCID_OAUTH_ISTEMCI=
ORCID_OAUTH_GIZLI=
